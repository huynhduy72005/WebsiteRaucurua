# Node 24: sao chep thanh .env neu muon tuy chinh.
PORT=3001
WEB_ORIGIN=http://localhost:5173
# Dat COOKIE_SECURE=true khi trien khai qua HTTPS.
COOKIE_SECURE=false

# Thong tin nay chi de tren may chu. Khong dung tien to VITE_ cho khoa bi mat.
# Tao tai khoan sandbox rieng tai https://sandbox.vnpayment.vn/devreg/
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5173/api/payments/vnpay/return
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# IPN: /api/payments/vnpay/ipn. VNPay can truy cap duoc URL cong khai nay.
